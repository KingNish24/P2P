---
import '../styles/global.css';

interface Props {
	title?: string;
}

const { title = "Astro + Tailwind (Static Cloudflare)" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-white text-[#1a1a1a] min-h-screen antialiased selection:bg-[#00c853] selection:text-white relative font-sans">
		<slot />
	</body>
</html>
