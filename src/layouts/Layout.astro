---
import '../styles/global.css';

interface Props {
	title?: string;
}

const { title = "Astro + Tailwind (Static Cloudflare)" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-[#fafaf9] text-neutral-900 min-h-screen antialiased selection:bg-emerald-500 selection:text-white relative font-sans">
		<div class="fixed inset-0 pointer-events-none bg-[radial-gradient(ellipse_80%_50%_at_50%_-20%,rgba(16,185,129,0.12),rgba(255,255,255,0))] z-0"></div>
		<div class="relative z-10">
			<slot />
		</div>
	</body>
</html>
