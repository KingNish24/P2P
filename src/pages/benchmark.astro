---
// src/pages/benchmark.astro
// u2netp segmentation benchmark, four implementations on the same input:
//   A  ORT WebGPU (previous implementation): fp16 model, JS pre/post
//   C  custom full-WebGPU WGSL engine (src/scripts/seg-engine): GPU pre/post, single pass, tiled-GEMM conv
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>u2netp Segmentation Benchmark: ORT vs custom WebGPU engine</title>
  <style>
    body { font-family: ui-sans-serif, system-ui, sans-serif; background: #0f172a; color: #f8fafc; margin: 0; padding: 24px; line-height: 1.5; }
    .container { max-width: 1240px; margin: 0 auto; }
    h1 { font-size: 24px; color: #38bdf8; margin: 0 0 4px; }
    h2 { font-size: 16px; color: #e2e8f0; margin: 0 0 12px; }
    p.sub { color: #94a3b8; font-size: 13px; margin: 0 0 20px; }
    .card { background: #1e293b; border: 1px solid #334155; border-radius: 12px; padding: 18px; margin-bottom: 20px; }
    .row { display: flex; flex-wrap: wrap; gap: 14px; align-items: end; }
    label { font-size: 12px; color: #94a3b8; display: flex; flex-direction: column; gap: 4px; }
    input, select { background: #0f172a; color: #f8fafc; border: 1px solid #475569; border-radius: 6px; padding: 7px 9px; font-size: 13px; }
    input[type=number] { width: 80px; }
    button { background: #2563eb; color: #fff; border: 0; padding: 9px 16px; border-radius: 8px; font-weight: 600; font-size: 13px; cursor: pointer; }
    button:hover { background: #1d4ed8; }
    button:disabled { background: #475569; cursor: not-allowed; }
    button.alt { background: #334155; }
    table { width: 100%; border-collapse: collapse; font-size: 13px; }
    th, td { text-align: left; padding: 7px 10px; border-bottom: 1px solid #334155; vertical-align: top; }
    th { color: #94a3b8; font-weight: 600; }
    td.num { font-family: ui-monospace, Consolas, monospace; }
    .win { color: #4ade80; }
    .lose { color: #f87171; }
    .bar { height: 8px; border-radius: 4px; margin-top: 4px; }
    .c-A { background: #f59e0b; } .c-C { background: #a78bfa; }
    .log { font-family: ui-monospace, Consolas, monospace; font-size: 12px; background: #020617; border: 1px solid #334155; border-radius: 8px; padding: 10px; height: 200px; overflow-y: auto; white-space: pre-wrap; word-break: break-word; }
    .err { color: #f87171; }
    .imgs { display: flex; gap: 10px; flex-wrap: wrap; }
    .imgs canvas { width: 160px; height: 160px; border-radius: 8px; background: #000; border: 1px solid #334155; }
    .imgs figcaption { font-size: 11px; color: #94a3b8; text-align: center; }
    .imgs figure { margin: 0; }
  </style>
</head>
<body>
  <div class="container">
    <h1>u2netp Segmentation Benchmark</h1>
    <p class="sub">A = ORT WebGPU (previous, fp16 model, JS pre/post) &nbsp;|&nbsp; C = custom full-WebGPU engine (GPU pre/post, no ORT, now used by the app)</p>

    <div class="card">
      <div class="row">
        <label>Sample
          <select id="sample">
            <option>corn</option><option>grape</option><option>potato</option><option>spinach</option><option>tomato</option>
          </select>
        </label>
        <label>Warmup <input id="warmup" type="number" value="3" min="0" max="50" /></label>
        <label>Runs (N) <input id="runs" type="number" value="20" min="1" max="500" /></label>
        <label>Engine C precision
          <select id="prec"><option value="auto">auto (f16 if available)</option><option value="f16">f16</option><option value="f32">f32</option></select>
        </label>
        <button id="run">Run benchmark</button>
        <button id="export" class="alt" disabled>Export JSON</button>
      </div>
      <p class="sub" style="margin:10px 0 0">"x" in the table is the speed-up vs A (higher = faster).</p>
    </div>

    <div class="card">
      <h2>Results</h2>
      <table id="results">
        <thead><tr><th>Metric</th><th>A: ORT</th><th>C: custom engine</th></tr></thead>
        <tbody><tr><td colspan="3" style="color:#64748b">No run yet.</td></tr></tbody>
      </table>
    </div>

    <div class="card" id="kcard" style="display:none">
      <h2>Engine C: GPU time per kernel type (one profiled run)</h2>
      <table id="kernels"><thead><tr><th>Type</th><th>Dispatches</th><th>ms</th><th>Share</th></tr></thead><tbody></tbody></table>
      <p class="sub" id="knote" style="margin-top:10px"></p>
    </div>

    <div class="card">
      <h2>Outputs</h2>
      <div class="imgs">
        <figure><canvas id="cIn" width="320" height="320"></canvas><figcaption>input 320x320</figcaption></figure>
        <figure><canvas id="mA" width="320" height="320"></canvas><figcaption>A mask</figcaption></figure>
        <figure><canvas id="mC" width="320" height="320"></canvas><figcaption>C mask</figcaption></figure>
      </div>
    </div>

    <div class="card">
      <h2>Log</h2>
      <div class="log" id="log"></div>
    </div>
  </div>

  <script>
    import { createSegEngine } from "../scripts/seg-engine/engine.js";

    const SIZE = 320, N = SIZE * SIZE;
    const IDS = ["A", "C"];
    const $ = (id) => document.getElementById(id);
    const logEl = $("log");
    let lastReport = null;

    function log(msg, isErr) {
      const line = document.createElement("div");
      if (isErr) line.className = "err";
      line.textContent = `[${(performance.now() / 1000).toFixed(2)}s] ${msg}`;
      logEl.appendChild(line);
      logEl.scrollTop = logEl.scrollHeight;
      (isErr ? console.error : console.log)(msg);
    }
    window.addEventListener("error", (e) => log(`window error: ${e.message}`, true));
    window.addEventListener("unhandledrejection", (e) => log(`unhandled rejection: ${(e.reason && e.reason.stack) || e.reason}`, true));

    const stats = (xs) => {
      const s = [...xs].sort((a, b) => a - b);
      const q = (p) => s[Math.min(s.length - 1, Math.floor(p * (s.length - 1) + 0.5))];
      return { median: q(0.5), mean: s.reduce((a, b) => a + b, 0) / s.length, p95: q(0.95), min: s[0], max: s[s.length - 1] };
    };
    const fmt = (v, d = 2) => (v == null || Number.isNaN(v) ? "-" : v.toFixed(d));
    const mb = (b) => (b == null ? "n/a" : (b / 1048576).toFixed(2) + " MB");

    async function loadRgba(name) {
      const img = new Image();
      img.src = `/samples/${name}.jpg`;
      await img.decode();
      const c = document.createElement("canvas");
      c.width = c.height = SIZE;
      const ctx = c.getContext("2d", { willReadFrequently: true });
      ctx.drawImage(img, 0, 0, SIZE, SIZE);
      return ctx.getImageData(0, 0, SIZE, SIZE).data;
    }

    // JS pre/post shared by A and D (same code as segment-worker.js)
    const floatData = new Float32Array(3 * N);
    function normalize(rgba) {
      for (let i = 0; i < N; i++) {
        const p = i * 4;
        floatData[i] = (rgba[p] / 255 - 0.485) / 0.229;
        floatData[N + i] = (rgba[p + 1] / 255 - 0.456) / 0.224;
        floatData[2 * N + i] = (rgba[p + 2] / 255 - 0.406) / 0.225;
      }
      return floatData;
    }
    function post(outData) {
      let min = Infinity, max = -Infinity;
      for (let i = 0; i < outData.length; i++) { const v = outData[i]; if (v < min) min = v; if (v > max) max = v; }
      const thr = min + 0.45 * ((max - min) || 1);
      const mask = new Uint8ClampedArray(N * 4);
      const edge = new Uint8ClampedArray(N * 4);
      let fg = 0;
      for (let y = 0; y < SIZE; y++) {
        for (let x = 0; x < SIZE; x++) {
          const idx = y * SIZE + x;
          if (outData[idx] <= thr) continue;
          fg++;
          const p = idx * 4;
          mask[p] = mask[p + 1] = mask[p + 2] = mask[p + 3] = 255;
          if (x === 0 || x === SIZE - 1 || y === 0 || y === SIZE - 1 ||
            outData[idx - 1] <= thr || outData[idx + 1] <= thr || outData[idx - SIZE] <= thr || outData[idx + SIZE] <= thr) {
            edge[p + 1] = 255; edge[p + 2] = 120; edge[p + 3] = 255;
          }
        }
      }
      return { mask, edge, fgCount: fg };
    }

    // ---------------------------------------------------------------- engines
    // Common shape: { model(rgba) -> Promise, e2e(rgba) -> {mask,edge,fgCount}, output(rgba) -> Float32Array, stats, destroy }
    async function createA(modelBytes) {
      const ort = await import("onnxruntime-web/webgpu");
      ort.env.wasm.wasmPaths = "https://cdn.jsdelivr.net/npm/onnxruntime-web@1.30.0/dist/";
      const session = await ort.InferenceSession.create(modelBytes, { executionProviders: ["webgpu"] });
      const inName = session.inputNames[0];
      const outName = session.outputNames[0];
      const run = async (rgba) => {
        const chw = normalize(rgba);
        const res = await session.run({ [inName]: new ort.Tensor("float32", chw, [1, 3, SIZE, SIZE]) });
        const t = res[outName];
        const data = await t.getData();
        return { data, t };
      };
      return {
        stats: {},
        async model(rgba) { const { t } = await run(rgba); t.dispose && t.dispose(); },
        async e2e(rgba) { const { data, t } = await run(rgba); const r = post(data); t.dispose && t.dispose(); return r; },
        async output(rgba) { const { data, t } = await run(rgba); const c = Float32Array.from(data); t.dispose && t.dispose(); return c; },
        destroy() { session.release && session.release(); }
      };
    }

    async function createC(modelBytes, f16) {
      const eng = await createSegEngine({ modelBytes, f16, size: SIZE });
      return {
        stats: { f16: eng.stats.f16, dispatches: eng.stats.dispatches, weightBytes: eng.stats.weightBytes, activationBytes: eng.stats.activationBytes, ioBytes: eng.stats.ioBytes, hasTimestamps: eng.stats.hasTimestamps },
        raw: eng,
        async model(rgba) { await eng.forward(rgba); },
        e2e(rgba) { return eng.infer(rgba); },
        async output(rgba) { await eng.forward(rgba); return eng.readOutput(); },
        destroy() { eng.destroy(); }
      };
    }

    function iou(a, b) {
      let inter = 0, uni = 0;
      for (let i = 0; i < N; i++) {
        const x = a[i * 4 + 3] > 0, y = b[i * 4 + 3] > 0;
        if (x && y) inter++;
        if (x || y) uni++;
      }
      return uni ? inter / uni : 1;
    }
    function drawMask(canvasId, mask) {
      $(canvasId).getContext("2d").putImageData(new ImageData(new Uint8ClampedArray(mask), SIZE, SIZE), 0, 0);
    }

    async function timeRuns(fn, warmup, runs, label) {
      const times = [];
      for (let i = 0; i < warmup; i++) await fn();
      for (let i = 0; i < runs; i++) {
        const t0 = performance.now();
        await fn();
        times.push(performance.now() - t0);
      }
      log(`${label}: median ${fmt(stats(times).median)} ms over ${runs} runs`);
      return times;
    }

    async function runBenchmark() {
      const btn = $("run");
      btn.disabled = true;
      $("export").disabled = true;
      logEl.textContent = "";
      const eng = {}; // id -> engine
      try {
        if (!navigator.gpu) throw new Error("WebGPU is not available in this browser.");
        const sample = $("sample").value;
        const warmup = Math.max(0, +$("warmup").value | 0);
        const runs = Math.max(1, +$("runs").value | 0);
        const prec = $("prec").value;
        const f16opt = prec === "auto" ? "auto" : prec === "f16";
        const ids = IDS;

        log("Fetching model and sample...");
        const modelBytes = new Uint8Array(await (await fetch("/models/u2netp.onnx")).arrayBuffer());
        const rgba = await loadRgba(sample);
        $("cIn").getContext("2d").putImageData(new ImageData(new Uint8ClampedArray(rgba), SIZE, SIZE), 0, 0);
        log(`Model ${mb(modelBytes.byteLength)}, sample ${sample}, engines ${ids.join("")}`);

        const factories = {
          A: () => createA(modelBytes),
          C: () => createC(modelBytes, f16opt)
        };

        const init = {}, first = {}, firstOut = {};
        for (const id of ids) {
          log(`Init ${id}...`);
          let t0 = performance.now();
          eng[id] = await factories[id]();
          init[id] = performance.now() - t0;
          t0 = performance.now();
          firstOut[id] = await eng[id].e2e(rgba);
          first[id] = performance.now() - t0;
          log(`${id}: init ${fmt(init[id], 0)} ms, first run ${fmt(first[id], 0)} ms ${JSON.stringify(eng[id].stats)}`);
        }

        // accuracy vs A (or vs the first engine when A is not selected)
        const ref = "A";
        const refOut = await eng[ref].output(rgba);
        const accuracy = {};
        for (const id of ids) {
          const out = id === ref ? refOut : await eng[id].output(rgba);
          let maxDiff = 0, sum = 0;
          for (let i = 0; i < N; i++) { const d = Math.abs(refOut[i] - out[i]); if (d > maxDiff) maxDiff = d; sum += d; }
          accuracy[id] = { maxDiff, meanDiff: sum / N, maskIoU: iou(firstOut[ref].mask, firstOut[id].mask), fg: firstOut[id].fgCount };
          log(`Accuracy ${id} vs ${ref}: max ${maxDiff.toExponential(2)}, mean ${(sum / N).toExponential(2)}, IoU ${accuracy[id].maskIoU.toFixed(5)}, fg ${firstOut[id].fgCount}`);
          drawMask(`m${id}`, firstOut[id].mask);
        }

        // timing: same input, sections interleaved across engines
        const modelOnly = {}, endToEnd = {};
        for (const id of ids) modelOnly[id] = stats(await timeRuns(() => eng[id].model(rgba), warmup, runs, `${id} model-only`));
        for (const id of ids) endToEnd[id] = stats(await timeRuns(() => eng[id].e2e(rgba), warmup, runs, `${id} end-to-end`));

        // per-kernel profile for the WGSL engines
        const prof = {};
        try { prof.C = await eng.C.raw.profile(rgba); } catch (e) { log(`profile unavailable: ${e.message}`, true); }

        const report = {
          userAgent: navigator.userAgent, sample, warmup, runs, engines: ids, ref,
          init, firstRun: first, modelOnly, endToEnd, accuracy,
          engineStats: Object.fromEntries(ids.map((id) => [id, eng[id].stats])),
          kernels: prof
        };
        lastReport = report;
        renderResults(report);
        renderKernels(prof);
        $("export").disabled = false;
        log("Done.");
      } catch (e) {
        log(`FAILED: ${(e && e.stack) || e}`, true);
      } finally {
        for (const id of Object.keys(eng)) { try { await eng[id].destroy(); } catch {} }
        btn.disabled = false;
      }
    }

    function renderResults(r) {
      const rows = [];
      const ids = r.engines;
      const cols = (fn) => IDS.map((id) => (ids.includes(id) ? fn(id) : `<td class="num" style="color:#475569">-</td>`)).join("");
      const timeRow = (name, get, unit = "ms") => {
        const base = r.engines.includes("A") ? get("A") : null;
        const maxv = Math.max(...ids.map((id) => get(id) || 0)) || 1;
        rows.push(`<tr><td>${name}</td>${cols((id) => {
          const v = get(id);
          let tag = "";
          if (base && id !== "A" && v) {
            const x = base / v;
            tag = ` <span class="${x >= 1 ? "win" : "lose"}">${x.toFixed(2)}x</span>`;
          }
          return `<td class="num">${fmt(v)} ${unit}${tag}<div class="bar c-${id}" style="width:${((v || 0) / maxv) * 100}%"></div></td>`;
        })}</tr>`);
      };
      const plain = (name, get) => rows.push(`<tr><td>${name}</td>${cols((id) => `<td class="num">${get(id)}</td>`)}</tr>`);
      const st = (id) => r.engineStats[id] || {};
      timeRow("Init time", (id) => r.init[id]);
      timeRow("First run (shader compile)", (id) => r.firstRun[id]);
      for (const [k, label] of [["modelOnly", "Model-only"], ["endToEnd", "End-to-end"]]) {
        for (const s of ["median", "mean", "p95", "min"]) timeRow(`${label} ${s}`, (id) => r[k][id][s]);
      }
      plain("Weights memory", (id) => (id === "A" ? "n/a (ORT)" : mb(st(id).weightBytes)));
      plain("Activation memory", (id) => (id === "A" ? "n/a (ORT)" : mb(st(id).activationBytes) + " (pool)"));
      plain("Dispatches / run", (id) => (id === "A" ? "n/a" : st(id).dispatches));
      plain("Precision", (id) => (id === "A" ? "fp16 model" : st(id).f16 ? "f16" : "f32"));
      plain(`Max |diff| vs ${r.ref}`, (id) => (id === r.ref ? "-" : r.accuracy[id].maxDiff.toExponential(2)));
      plain(`Mean |diff| vs ${r.ref}`, (id) => (id === r.ref ? "-" : r.accuracy[id].meanDiff.toExponential(2)));
      plain(`Mask IoU vs ${r.ref}`, (id) => (id === r.ref ? "-" : r.accuracy[id].maskIoU.toFixed(5)));
      plain("Foreground pixels", (id) => r.accuracy[id].fg);
      $("results").querySelector("tbody").innerHTML = rows.join("");
    }

    function renderKernels(prof) {
      const card = $("kcard");
      card.style.display = "block";
      const by = {};
      for (const k of prof.C || []) {
        const e = (by[k.type] ||= { n: 0, ms: 0 });
        e.n++;
        e.ms += k.ms;
      }
      const total = Object.values(by).reduce((x, e) => x + e.ms, 0) || 1;
      $("kernels").querySelector("tbody").innerHTML = Object.entries(by).sort((a, b) => b[1].ms - a[1].ms).map(([t, e]) =>
        `<tr><td>${t}</td><td class="num">${e.n}</td><td class="num">${e.ms.toFixed(3)}</td><td class="num">${((e.ms / total) * 100).toFixed(1)}%<div class="bar c-C" style="width:${(e.ms / total) * 100}%"></div></td></tr>`).join("");
      $("knote").textContent = `Sum of kernel times: ${total.toFixed(2)} ms. Chrome quantizes timestamps (~100 us) unless run with --enable-dawn-features=allow_unsafe_apis.`;
    }

    $("run").addEventListener("click", runBenchmark);
    $("export").addEventListener("click", () => {
      if (!lastReport) return;
      const blob = new Blob([JSON.stringify(lastReport, null, 2)], { type: "application/json" });
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = `seg-benchmark-${Date.now()}.json`;
      a.click();
    });
    log(navigator.gpu ? "WebGPU available. Press Run." : "WebGPU NOT available.", !navigator.gpu);
  </script>
</body>
</html>
