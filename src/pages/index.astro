---
import Layout from '../layouts/Layout.astro';
---

<Layout title="PhytoAI | On-Device Crop Disease Diagnosis & Edge AI">
	<!-- Sticky Header Navbar -->
	<header class="sticky top-0 z-40 bg-white/85 backdrop-blur-md border-b border-neutral-200/80 transition-colors">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
			<a href="#" class="flex items-center gap-2.5 text-neutral-900 group">
				<div class="w-8 h-8 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-600 transition group-hover:bg-emerald-500 group-hover:text-white">
					<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 0 0 9-9c0-4.97-4.03-9-9-9S3 7.03 3 12a9 9 0 0 0 9 9zm0 0v-8m0 0a4 4 0 0 1 4-4m-4 4a4 4 0 0 0-4-4" />
					</svg>
				</div>
				<span class="font-bold text-base tracking-tight text-neutral-900">PhytoAI</span>
				<span class="text-[10px] font-mono uppercase tracking-widest px-2 py-0.5 rounded-full bg-emerald-100/70 text-emerald-800 border border-emerald-200 font-semibold">Edge</span>
			</a>

			<nav class="hidden md:flex items-center gap-6 text-xs font-medium text-neutral-600">
				<a href="#app" class="hover:text-neutral-900 transition">Diagnose</a>
				<a href="#features" class="hover:text-neutral-900 transition">Features</a>
				<a href="#architecture" class="hover:text-neutral-900 transition">Architecture</a>
			</nav>

			<div class="flex items-center gap-3">
				<!-- WebGPU Status Badge -->
				<div id="webgpu-badge" class="flex items-center gap-1.5 text-[11px] font-mono text-neutral-700 bg-neutral-100/80 border border-neutral-200/90 px-2.5 py-1 rounded-full shadow-2xs">
					<span id="webgpu-dot" class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
					<span id="webgpu-status">WebGPU</span>
				</div>

				<!-- GitHub Repo Link -->
				<a href="https://github.com" target="_blank" rel="noopener noreferrer" aria-label="GitHub Repository" class="p-2 rounded-xl text-neutral-600 hover:text-neutral-900 hover:bg-neutral-100 border border-transparent hover:border-neutral-200 transition">
					<svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
						<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
					</svg>
				</a>
			</div>
		</div>
	</header>

	<main class="max-w-6xl mx-auto px-4 sm:px-6">
		<!-- Hero Section -->
		<section class="pt-16 pb-14 text-center max-w-3xl mx-auto space-y-6">
			<!-- Privacy Announcement Badge -->
			<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200/90 text-xs font-medium shadow-2xs">
				<svg class="w-3.5 h-3.5 text-emerald-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
					<path stroke-linecap="round" stroke-linejoin="round" d="M7 11V7a5 5 0 0 1 10 0v4" />
				</svg>
				<span>100% On-Device &amp; Private &middot; Zero Images Sent to Servers</span>
			</div>

			<h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-neutral-900 leading-[1.12]">
				Private crop diagnosis,<br class="hidden sm:inline" /> powered by edge AI.
			</h1>

			<p class="text-base sm:text-lg text-neutral-600 leading-relaxed font-normal max-w-2xl mx-auto">
				Instant plant disease detection and treatment protocols directly in your browser. No cloud uploads, no API keys, zero tracking.
			</p>

			<!-- Action Buttons -->
			<div class="flex flex-wrap items-center justify-center gap-3 pt-2">
				<a href="#app" class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-neutral-900 hover:bg-neutral-800 text-white font-medium text-xs tracking-wider uppercase shadow-md hover:shadow-lg transition cursor-pointer">
					<span>Diagnose Plant</span>
					<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
						<path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
					</svg>
				</a>
				<a href="https://github.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-white hover:bg-neutral-50 text-neutral-800 border border-neutral-200/90 font-medium text-xs tracking-wider uppercase shadow-xs transition">
					<svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
						<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
					</svg>
					<span>GitHub</span>
				</a>
			</div>

			<!-- Trust Highlights Bar -->
			<div class="pt-6 flex flex-wrap items-center justify-center gap-6 sm:gap-8 text-neutral-500 text-xs">
				<div class="flex items-center gap-1.5">
					<svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M18.364 5.636a9 9 0 010 12.728m0 0l-2.829-2.829m2.829 2.829L21 21M15.536 8.464a5 5 0 010 7.072m0 0l-2.829-2.829m-4.243 4.243a9 9 0 01-2.829-2.829m0 0L3 21m2.829-5.657A5 5 0 013 12c0-1.38.56-2.63 1.464-3.536M3 3l18 18" />
					</svg>
					<span class="font-medium text-neutral-700">Zero Cloud Uploads</span>
				</div>
				<div class="flex items-center gap-1.5">
					<svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<rect x="4" y="4" width="16" height="16" rx="2" />
						<rect x="9" y="9" width="6" height="6" />
						<path stroke-linecap="round" stroke-linejoin="round" d="M9 1v3m6-3v3M9 20v3m6-3v3M20 9h3m-3 6h3M1 9h3m-3 6h3" />
					</svg>
					<span class="font-medium text-neutral-700">Client-side WebGPU</span>
				</div>
				<div class="flex items-center gap-1.5">
					<svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
					</svg>
					<span class="font-medium text-neutral-700">Open Source</span>
				</div>
			</div>
		</section>

		<!-- Core Diagnostic App Container -->
		<section id="app" class="scroll-mt-24 max-w-3xl mx-auto mb-20">
			<!-- Ente-style White Card -->
			<div class="bg-white border border-neutral-200/90 rounded-3xl p-6 sm:p-8 shadow-sm transition hover:shadow-md space-y-6">
				<div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-neutral-100">
					<div>
						<h2 class="text-xl sm:text-2xl font-bold tracking-tight text-neutral-900">Crop Health Analysis</h2>
						<p class="text-xs text-neutral-500 mt-0.5">LFM2.5-VL-450M vision language model executing locally in your browser.</p>
					</div>
					<div class="text-[11px] font-mono text-neutral-500 bg-neutral-50 border border-neutral-200/80 px-2.5 py-1 rounded-full">
						q4f16 &middot; 450M
					</div>
				</div>

				<!-- Loading / Progress bar / Error banner -->
				<div id="progress-container" class="hidden p-4 rounded-2xl bg-neutral-50 border border-neutral-200/90 space-y-2 text-neutral-700">
					<div class="flex justify-between text-xs font-mono text-neutral-600">
						<span id="progress-file" class="break-all font-medium">Loading model...</span>
						<span id="progress-percent" class="text-emerald-600 font-bold ml-2">0%</span>
					</div>
					<div id="progress-bar-wrap" class="w-full h-1.5 rounded-full bg-neutral-200/80 overflow-hidden">
						<div id="progress-fill" class="h-full bg-emerald-500 transition-all duration-150" style="width: 0%"></div>
					</div>
				</div>

				<!-- Image Input Dropzone -->
				<div class="space-y-3">
					<div id="dropzone" class="relative group border border-dashed border-neutral-300 hover:border-emerald-500 bg-neutral-50/70 hover:bg-emerald-50/20 rounded-2xl p-8 text-center transition cursor-pointer min-h-[220px] flex flex-col items-center justify-center overflow-hidden">
						<input type="file" id="file-input" accept="image/*" class="absolute inset-0 opacity-0 cursor-pointer z-10" />
						
						<div id="upload-placeholder" class="space-y-3">
							<div class="w-12 h-12 rounded-2xl bg-emerald-500/10 text-emerald-700 border border-emerald-500/20 flex items-center justify-center mx-auto transition group-hover:scale-105">
								<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
									<path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
								</svg>
							</div>
							<div>
								<p class="text-sm font-semibold text-neutral-900">Drop plant, crop, fruit, or leaf image here</p>
								<p class="text-xs text-neutral-500 mt-0.5">Click to browse or drag &amp; drop from your files</p>
							</div>
						</div>

						<img id="image-preview" class="hidden max-h-72 max-w-full rounded-xl object-contain shadow-sm" alt="Selected Plant or Crop" />
					</div>

					<div class="flex gap-2">
						<button id="btn-camera" type="button" class="flex-1 py-2.5 px-3 rounded-xl border border-neutral-200/90 bg-neutral-50 hover:bg-neutral-100 text-neutral-800 text-xs font-medium transition cursor-pointer flex items-center justify-center gap-1.5">
							<svg class="w-4 h-4 text-neutral-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
								<circle cx="12" cy="13" r="4" />
							</svg>
							<span>Camera</span>
						</button>
						<button id="btn-clear" type="button" class="hidden py-2.5 px-3 rounded-xl border border-rose-200/80 bg-rose-50 hover:bg-rose-100 text-rose-700 text-xs font-medium transition cursor-pointer">
							Remove
						</button>
					</div>
				</div>

				<!-- Symptoms Note -->
				<div>
					<input type="text" id="user-note" placeholder="Symptoms note (e.g. yellow spots appeared on lower leaves after rain)..." class="w-full bg-neutral-50 border border-neutral-200/90 text-neutral-900 placeholder-neutral-400 rounded-xl px-4 py-2.5 text-xs focus:bg-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/10 focus:outline-none transition" />
				</div>

				<!-- Action Button -->
				<button id="btn-analyze" disabled type="button" class="w-full py-3.5 rounded-2xl bg-emerald-600 hover:bg-emerald-500 disabled:bg-neutral-200 disabled:text-neutral-400 disabled:cursor-not-allowed text-white font-bold text-xs uppercase tracking-wider shadow-md shadow-emerald-600/20 transition cursor-pointer flex items-center justify-center gap-2">
					<span id="btn-icon" class="flex items-center">
						<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
						</svg>
					</span>
					<span id="btn-text">Diagnose Plant</span>
				</button>

				<!-- Reasoning Stream Box -->
				<section id="reasoning-section" class="hidden pt-4 border-t border-neutral-100 space-y-2">
					<div class="flex items-center justify-between text-xs text-neutral-500 font-mono">
						<span class="flex items-center gap-1.5 text-emerald-600 font-medium">
							<span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
							LFM2.5 Reasoning (CoT)
						</span>
						<span id="token-counter">0 tokens</span>
					</div>
					<div id="reasoning-box" class="p-4 rounded-2xl bg-neutral-900 text-neutral-200 border border-neutral-800 font-mono text-xs shadow-md leading-relaxed whitespace-pre-wrap max-h-48 overflow-y-auto"></div>
				</section>

				<!-- Structured Result Card -->
				<section id="result-card" class="hidden pt-6 border-t border-neutral-100 space-y-6 text-neutral-900">
					<!-- Header -->
					<div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-neutral-200/80">
						<div>
							<div class="flex items-center gap-2 mb-1.5">
								<span id="res-status" class="px-2.5 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider"></span>
								<span id="res-pathogen" class="px-2 py-0.5 rounded-full text-xs bg-neutral-100 text-neutral-700 font-mono border border-neutral-200"></span>
								<span id="res-confidence" class="text-xs font-mono text-neutral-500"></span>
							</div>
							<h3 id="res-disease" class="text-2xl font-bold text-neutral-900 tracking-tight"></h3>
							<p id="res-crop" class="text-xs text-neutral-500 mt-0.5"></p>
						</div>
					</div>

					<!-- Symptoms -->
					<div>
						<h4 class="text-xs font-semibold uppercase tracking-wider text-neutral-500 mb-2">Observed Symptoms</h4>
						<ul id="res-symptoms" class="text-neutral-700 list-disc list-inside space-y-1.5 text-xs"></ul>
					</div>

					<!-- Treatments Grid -->
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
						<!-- Organic Box -->
						<div class="p-5 rounded-2xl bg-emerald-50/70 border border-emerald-200/80 text-emerald-950">
							<div class="flex items-center gap-1.5 mb-2.5">
								<svg class="w-4 h-4 text-emerald-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 0 0 9-9c0-4.97-4.03-9-9-9S3 7.03 3 12a9 9 0 0 0 9 9zm0 0v-8m0 0a4 4 0 0 1 4-4m-4 4a4 4 0 0 0-4-4" />
								</svg>
								<h5 class="text-xs font-bold uppercase tracking-wider text-emerald-800">Organic Remedies</h5>
							</div>
							<ul id="res-organic" class="space-y-1.5 text-xs text-emerald-900 list-disc list-inside"></ul>
						</div>

						<!-- Chemical Box -->
						<div class="p-5 rounded-2xl bg-sky-50/70 border border-sky-200/80 text-sky-950">
							<div class="flex items-center gap-1.5 mb-2.5">
								<svg class="w-4 h-4 text-sky-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 21a3 3 0 0 1-3 3H7.5a3 3 0 0 1-3-3l1.5-7.5V6a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v7.5l1.5 7.5zM9 4v4m6-4v4" />
								</svg>
								<h5 class="text-xs font-bold uppercase tracking-wider text-sky-800">Chemical Controls</h5>
							</div>
							<ul id="res-chemical" class="space-y-1.5 text-xs text-sky-900 list-disc list-inside"></ul>
						</div>
					</div>

					<!-- Prevention Box -->
					<div class="p-5 rounded-2xl bg-neutral-50 border border-neutral-200/80 text-neutral-800">
						<div class="flex items-center gap-1.5 mb-2.5">
							<svg class="w-4 h-4 text-neutral-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
							</svg>
							<h5 class="text-xs font-bold uppercase tracking-wider text-neutral-700">Prevention Protocols</h5>
						</div>
						<ul id="res-prevention" class="space-y-1.5 text-xs text-neutral-700 list-disc list-inside"></ul>
					</div>
				</section>
			</div>
		</section>

		<!-- Feature Grid -->
		<section id="features" class="scroll-mt-24 py-12 border-t border-neutral-200/70">
			<div class="text-center max-w-xl mx-auto mb-10 space-y-2">
				<h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-neutral-900">Engineered for absolute privacy</h2>
				<p class="text-xs sm:text-sm text-neutral-600">Zero telemetry, local machine learning models, and uncompromising plant diagnostics.</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
				<!-- Card 1 -->
				<div class="p-6 rounded-3xl bg-white border border-neutral-200/80 shadow-2xs hover:shadow-sm transition space-y-3">
					<div class="w-10 h-10 rounded-2xl bg-emerald-50 border border-emerald-200/80 text-emerald-700 flex items-center justify-center">
						<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
						</svg>
					</div>
					<h3 class="text-sm font-bold text-neutral-900">Client-Side Privacy</h3>
					<p class="text-xs text-neutral-600 leading-relaxed">
						Images are processed in sandbox memory directly on your GPU or CPU. No photographs ever leave your browser or get logged on remote servers.
					</p>
				</div>

				<!-- Card 2 -->
				<div class="p-6 rounded-3xl bg-white border border-neutral-200/80 shadow-2xs hover:shadow-sm transition space-y-3">
					<div class="w-10 h-10 rounded-2xl bg-emerald-50 border border-emerald-200/80 text-emerald-700 flex items-center justify-center">
						<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<rect x="4" y="4" width="16" height="16" rx="2" />
							<rect x="9" y="9" width="6" height="6" />
							<path stroke-linecap="round" stroke-linejoin="round" d="M9 1v3m6-3v3M9 20v3m6-3v3M20 9h3m-3 6h3M1 9h3m-3 6h3" />
						</svg>
					</div>
					<h3 class="text-sm font-bold text-neutral-900">LFM2.5-VL Edge Architecture</h3>
					<p class="text-xs text-neutral-600 leading-relaxed">
						Highly optimized 450M parameter vision-language model compiled to WebGPU WGSL shaders. Runs smoothly on consumer laptops and mobile devices.
					</p>
				</div>

				<!-- Card 3 -->
				<div class="p-6 rounded-3xl bg-white border border-neutral-200/80 shadow-2xs hover:shadow-sm transition space-y-3">
					<div class="w-10 h-10 rounded-2xl bg-emerald-50 border border-emerald-200/80 text-emerald-700 flex items-center justify-center">
						<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 21a3 3 0 0 1-3 3H7.5a3 3 0 0 1-3-3l1.5-7.5V6a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v7.5l1.5 7.5zM9 4v4m6-4v4" />
						</svg>
					</div>
					<h3 class="text-sm font-bold text-neutral-900">Dual Agronomic Treatments</h3>
					<p class="text-xs text-neutral-600 leading-relaxed">
						Instant dual recommendations pairing bio-friendly organic interventions with targeted chemical controls and seasonal preventative maintenance.
					</p>
				</div>
			</div>
		</section>

		<!-- Comparison Matrix -->
		<section id="architecture" class="scroll-mt-24 py-12 border-t border-neutral-200/70 mb-16">
			<div class="text-center max-w-xl mx-auto mb-10 space-y-2">
				<h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-neutral-900">Cloud AI vs PhytoAI Edge</h2>
				<p class="text-xs sm:text-sm text-neutral-600">Why local execution is the optimal architectural pattern for agricultural diagnostics.</p>
			</div>

			<div class="overflow-hidden bg-white border border-neutral-200/80 rounded-3xl shadow-2xs">
				<div class="overflow-x-auto">
					<table class="w-full text-left text-xs border-collapse">
						<thead>
							<tr class="border-b border-neutral-200 bg-neutral-50/80 text-neutral-600 font-mono">
								<th class="py-3.5 px-6 font-semibold">Architectural Vector</th>
								<th class="py-3.5 px-6 font-semibold text-neutral-400">Traditional Cloud AI</th>
								<th class="py-3.5 px-6 font-semibold text-emerald-700 bg-emerald-50/40">PhytoAI On-Device</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-neutral-100 text-neutral-700">
							<tr>
								<td class="py-4 px-6 font-medium text-neutral-900">Data Privacy</td>
								<td class="py-4 px-6 text-neutral-500">Crop images uploaded to central servers</td>
								<td class="py-4 px-6 font-semibold text-emerald-800 bg-emerald-50/20">Zero cloud transmission (100% on-device)</td>
							</tr>
							<tr>
								<td class="py-4 px-6 font-medium text-neutral-900">Offline Capability</td>
								<td class="py-4 px-6 text-neutral-500">Requires constant high-speed connection</td>
								<td class="py-4 px-6 font-semibold text-emerald-800 bg-emerald-50/20">Caches weights; works in field offline</td>
							</tr>
							<tr>
								<td class="py-4 px-6 font-medium text-neutral-900">Inference Latency</td>
								<td class="py-4 px-6 text-neutral-500">Variable (network round-trip + server queue)</td>
								<td class="py-4 px-6 font-semibold text-emerald-800 bg-emerald-50/20">Real-time local GPU streaming</td>
							</tr>
							<tr>
								<td class="py-4 px-6 font-medium text-neutral-900">Operational Cost</td>
								<td class="py-4 px-6 text-neutral-500">Per-token API fees and server subscriptions</td>
								<td class="py-4 px-6 font-semibold text-emerald-800 bg-emerald-50/20">Zero server cost ($0.00 / perpetual)</td>
							</tr>
							<tr>
								<td class="py-4 px-6 font-medium text-neutral-900">Auditability</td>
								<td class="py-4 px-6 text-neutral-500">Closed-source black box API</td>
								<td class="py-4 px-6 font-semibold text-emerald-800 bg-emerald-50/20">Open weights, open source code</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
		</section>
	</main>

	<!-- Minimalist Footer -->
	<footer class="border-t border-neutral-200/80 bg-white py-12">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-neutral-500">
			<div class="flex items-center gap-2">
				<div class="w-5 h-5 rounded-lg bg-emerald-500/10 text-emerald-600 flex items-center justify-center">
					<svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 0 0 9-9c0-4.97-4.03-9-9-9S3 7.03 3 12a9 9 0 0 0 9 9zm0 0v-8m0 0a4 4 0 0 1 4-4m-4 4a4 4 0 0 0-4-4" />
					</svg>
				</div>
				<span class="font-bold text-neutral-800">PhytoAI</span>
				<span>&middot; Edge AI Agronomic Diagnostic Platform</span>
			</div>
			<p class="text-center sm:text-right">
				For research and agricultural assistance. Powered by WebGPU &amp; LFM2.5-VL.
			</p>
		</div>
	</footer>

	<!-- Camera Modal -->
	<div id="camera-modal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4">
		<div class="bg-white border border-neutral-200 rounded-3xl max-w-sm w-full p-5 shadow-2xl space-y-3">
			<div class="flex items-center justify-between">
				<span class="text-xs font-bold text-neutral-900">Capture Plant Photo</span>
				<button id="btn-close-camera" type="button" class="text-neutral-400 hover:text-neutral-700 transition p-1">
					<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
					</svg>
				</button>
			</div>
			<div class="relative rounded-2xl overflow-hidden bg-neutral-950 aspect-square">
				<video id="camera-video" autoplay playsinline class="w-full h-full object-cover"></video>
			</div>
			<div class="flex gap-2">
				<button id="btn-snap" type="button" class="flex-1 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs transition cursor-pointer">
					Snap Photo
				</button>
				<button id="btn-cancel-camera" type="button" class="py-2.5 px-3 rounded-xl border border-neutral-200 text-neutral-700 hover:bg-neutral-50 text-xs font-medium transition cursor-pointer">
					Cancel
				</button>
			</div>
		</div>
	</div>

	<!-- Client Script -->
	<script>
		let worker = null;
		let selectedImageDataUrl = null;
		let cameraStream = null;
		let tokenCount = 0;

		const iconBolt = `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`;
		const iconSpinner = `<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path></svg>`;
		const iconError = `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>`;

		const webgpuDot = document.getElementById('webgpu-dot');
		const webgpuStatus = document.getElementById('webgpu-status');

		const progressContainer = document.getElementById('progress-container');
		const progressFile = document.getElementById('progress-file');
		const progressPercent = document.getElementById('progress-percent');
		const progressFill = document.getElementById('progress-fill');
		const progressBarWrap = document.getElementById('progress-bar-wrap');

		const dropzone = document.getElementById('dropzone');
		const fileInput = document.getElementById('file-input');
		const uploadPlaceholder = document.getElementById('upload-placeholder');
		const imagePreview = document.getElementById('image-preview');
		const btnClear = document.getElementById('btn-clear');
		const userNoteInput = document.getElementById('user-note');
		const btnAnalyze = document.getElementById('btn-analyze');
		const btnIcon = document.getElementById('btn-icon');
		const btnText = document.getElementById('btn-text');

		const reasoningSection = document.getElementById('reasoning-section');
		const reasoningBox = document.getElementById('reasoning-box');
		const tokenCounter = document.getElementById('token-counter');

		const resultCard = document.getElementById('result-card');
		const resStatus = document.getElementById('res-status');
		const resPathogen = document.getElementById('res-pathogen');
		const resConfidence = document.getElementById('res-confidence');
		const resDisease = document.getElementById('res-disease');
		const resCrop = document.getElementById('res-crop');
		const resSymptoms = document.getElementById('res-symptoms');
		const resOrganic = document.getElementById('res-organic');
		const resChemical = document.getElementById('res-chemical');
		const resPrevention = document.getElementById('res-prevention');

		const btnCamera = document.getElementById('btn-camera');
		const cameraModal = document.getElementById('camera-modal');
		const cameraVideo = document.getElementById('camera-video');
		const btnCloseCamera = document.getElementById('btn-close-camera');
		const btnCancelCamera = document.getElementById('btn-cancel-camera');
		const btnSnap = document.getElementById('btn-snap');

		function showError(msg) {
			progressContainer.classList.remove('hidden');
			progressFile.innerHTML = `<span class="text-rose-400 font-bold">Error:</span> ${msg}`;
			progressPercent.textContent = '!';
			progressFill.className = 'h-full bg-rose-500';
			btnAnalyze.disabled = false;
			btnText.textContent = 'Retry Diagnosis';
			btnIcon.innerHTML = iconError;
		}

		async function checkWebGPU() {
			if ('gpu' in navigator) {
				try {
					const adapter = await navigator.gpu.requestAdapter();
					if (adapter) {
						webgpuDot.className = 'w-1.5 h-1.5 rounded-full bg-emerald-400';
						webgpuStatus.textContent = 'WebGPU Ready';
						return true;
					}
				} catch (e) {
					console.warn(e);
				}
			}
			webgpuDot.className = 'w-1.5 h-1.5 rounded-full bg-amber-400';
			webgpuStatus.textContent = 'WebGPU Fallback';
			return false;
		}

		function getWorker() {
			if (worker) return worker;

			worker = new Worker(new URL('../scripts/ai-worker.js', import.meta.url), {
				type: 'module'
			});

			worker.onerror = (e) => {
				console.error('Worker error event:', e);
				showError(e.message || 'Worker script failed to execute (CORS or network error).');
			};

			worker.addEventListener('message', (event) => {
				const { type, status, message, progress, token, fullText, data } = event.data;

				if (type === 'status') {
					if (status === 'loading') {
						progressContainer.classList.remove('hidden');
						progressFile.textContent = message;
						btnText.textContent = 'Loading Weights...';
					} else if (status === 'ready') {
						progressContainer.classList.add('hidden');
					} else if (status === 'analyzing') {
						btnText.textContent = 'Reasoning...';
					}
				}

				if (type === 'progress') {
					progressContainer.classList.remove('hidden');
					if (progress.file) progressFile.textContent = progress.file;
					if (progress.progress !== undefined) {
						const pct = Math.round(progress.progress);
						progressPercent.textContent = `${pct}%`;
						progressFill.style.width = `${pct}%`;
					}
				}

				if (type === 'token') {
					tokenCount++;
					tokenCounter.textContent = `${tokenCount} tokens`;
					reasoningSection.classList.remove('hidden');
					reasoningBox.textContent = fullText;
					reasoningBox.scrollTop = reasoningBox.scrollHeight;
				}

				if (type === 'result') {
					renderResult(data);
					btnAnalyze.disabled = false;
					btnText.textContent = 'Diagnose Plant';
					btnIcon.innerHTML = iconBolt;
				}

				if (type === 'error') {
					showError(message);
				}
			});

			return worker;
		}

		function renderResult(data) {
			resultCard.classList.remove('hidden');

			const isHealthy = data.status === 'healthy';
			resStatus.textContent = isHealthy ? 'HEALTHY' : 'DISEASED';
			resStatus.className = isHealthy 
				? 'px-2.5 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-300'
				: 'px-2.5 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-100 text-rose-800 border border-rose-300';

			if (data.pathogen_type) {
				resPathogen.textContent = data.pathogen_type.toUpperCase();
				resPathogen.classList.remove('hidden');
			} else {
				resPathogen.classList.add('hidden');
			}
			resConfidence.textContent = `Confidence: ${(data.confidence || 'medium').toUpperCase()}`;
			resDisease.textContent = data.disease_name || 'Diagnosis';
			resCrop.innerHTML = `Crop: <span class="text-neutral-900 font-semibold">${data.crop || 'Plant'}</span>`;

			resSymptoms.innerHTML = (data.key_symptoms || []).map(s => `<li>${s}</li>`).join('');
			resOrganic.innerHTML = (data.organic_treatment || []).map(t => `<li>${t}</li>`).join('');
			resChemical.innerHTML = (data.chemical_treatment || []).map(c => `<li>${c}</li>`).join('');
			resPrevention.innerHTML = (data.prevention_measures || []).map(p => `<li>${p}</li>`).join('');

			resultCard.scrollIntoView({ behavior: 'smooth' });
		}

		function setImage(dataUrl) {
			selectedImageDataUrl = dataUrl;
			imagePreview.src = dataUrl;
			imagePreview.classList.remove('hidden');
			uploadPlaceholder.classList.add('hidden');
			btnClear.classList.remove('hidden');
			btnAnalyze.disabled = false;
		}

		function clearImage() {
			selectedImageDataUrl = null;
			imagePreview.src = '';
			imagePreview.classList.add('hidden');
			uploadPlaceholder.classList.remove('hidden');
			btnClear.classList.add('hidden');
			btnAnalyze.disabled = true;
			fileInput.value = '';
			resultCard.classList.add('hidden');
			reasoningSection.classList.add('hidden');
		}

		fileInput.addEventListener('change', (e) => {
			const file = e.target.files[0];
			if (file) {
				const reader = new FileReader();
				reader.onload = (evt) => setImage(evt.target.result);
				reader.readAsDataURL(file);
			}
		});

		['dragenter', 'dragover'].forEach((type) => {
			dropzone.addEventListener(type, (e) => {
				e.preventDefault();
				e.stopPropagation();
				dropzone.classList.add('border-emerald-500', 'bg-emerald-50/40');
			});
		});

		dropzone.addEventListener('dragleave', (e) => {
			e.preventDefault();
			e.stopPropagation();
			dropzone.classList.remove('border-emerald-500', 'bg-emerald-50/40');
		});

		dropzone.addEventListener('drop', (e) => {
			e.preventDefault();
			e.stopPropagation();
			dropzone.classList.remove('border-emerald-500', 'bg-emerald-50/40');
			const file = e.dataTransfer?.files?.[0];
			if (file && file.type.startsWith('image/')) {
				const reader = new FileReader();
				reader.onload = (evt) => setImage(evt.target.result);
				reader.readAsDataURL(file);
			}
		});

		btnClear.addEventListener('click', clearImage);

		btnAnalyze.addEventListener('click', () => {
			if (!selectedImageDataUrl) return;

			tokenCount = 0;
			tokenCounter.textContent = '0 tokens';
			reasoningSection.classList.remove('hidden');
			reasoningBox.textContent = '// Model starting reasoning phase (first field)...\n';

			btnAnalyze.disabled = true;
			btnText.textContent = 'Thinking...';
			btnIcon.innerHTML = iconSpinner;

			const w = getWorker();
			w.postMessage({
				type: 'analyze',
				data: {
					image: selectedImageDataUrl,
					userNote: userNoteInput.value.trim()
				}
			});
		});

		// Camera
		btnCamera.addEventListener('click', async () => {
			cameraModal.classList.remove('hidden');
			try {
				cameraStream = await navigator.mediaDevices.getUserMedia({
					video: { facingMode: 'environment' }
				});
				cameraVideo.srcObject = cameraStream;
			} catch (err) {
				alert('Camera access denied or unavailable: ' + err.message);
				cameraModal.classList.add('hidden');
			}
		});

		function stopCamera() {
			if (cameraStream) {
				cameraStream.getTracks().forEach(t => t.stop());
				cameraStream = null;
			}
			cameraModal.classList.add('hidden');
		}

		btnCloseCamera.addEventListener('click', stopCamera);
		btnCancelCamera.addEventListener('click', stopCamera);

		btnSnap.addEventListener('click', () => {
			const canvas = document.createElement('canvas');
			canvas.width = cameraVideo.videoWidth || 640;
			canvas.height = cameraVideo.videoHeight || 480;
			const ctx = canvas.getContext('2d');
			ctx.drawImage(cameraVideo, 0, 0, canvas.width, canvas.height);
			setImage(canvas.toDataURL('image/jpeg', 0.85));
			stopCamera();
		});

		checkWebGPU();
	</script>
</Layout>
