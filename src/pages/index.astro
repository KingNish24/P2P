---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Disease Dekho AI | Safe Diagnosis for Your Crops & Edge AI">
	<!-- Sticky Header Navbar -->
	<header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-neutral-100 transition-colors">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
			<!-- Logo: Seedling SVG with #00c853 fill + Disease Dekho AI in bold text-[#1a1a1a] -->
			<a href="#" class="flex items-center gap-2.5 group">
				<div class="w-8 h-8 rounded-xl flex items-center justify-center transition group-hover:scale-105">
					<svg class="w-6 h-6 fill-[#00c853]" viewBox="0 0 24 24">
						<path d="M21 3c-6.627 0-12 5.373-12 12v1H7a5 5 0 0 0-5 5h2a3 3 0 0 1 3-3h4a2 2 0 0 0 2-2v-3c0-4.418 3.582-8 8-8V3z"/>
						<path d="M12 13a4 4 0 0 0-4-4H7a6 6 0 0 0-6 6h2a4 4 0 0 1 4-4h1a2 2 0 0 1 2 2v1h2v-1z" opacity=".6"/>
					</svg>
				</div>
				<span class="font-bold text-lg tracking-tight text-[#1a1a1a]">Disease Dekho AI</span>
			</a>

			<!-- Center Nav Links -->
			<nav class="hidden md:flex items-center gap-8 text-sm font-medium text-neutral-500">
				<a href="#features" class="hover:text-[#1a1a1a] transition">Features</a>
				<a href="#architecture" class="hover:text-[#1a1a1a] transition">Architecture</a>
				<a href="#app" class="hover:text-[#1a1a1a] transition">Diagnose</a>
			</nav>

			<!-- Right: WebGPU live badge & GitHub SVG link -->
			<div class="flex items-center gap-3">
				<!-- WebGPU live chip badge -->
				<div id="webgpu-badge" class="flex items-center gap-1.5 text-xs font-mono text-neutral-600 bg-neutral-100 px-3 py-1 rounded-full">
					<span id="webgpu-dot" class="w-2 h-2 rounded-full bg-amber-400"></span>
					<span id="webgpu-status">WebGPU</span>
				</div>

				<!-- GitHub SVG link -->
				<a href="https://github.com/KingNish24/P2P" target="_blank" rel="noopener noreferrer" aria-label="GitHub Repository" class="p-2 rounded-full text-neutral-600 hover:text-[#1a1a1a] hover:bg-neutral-100 transition">
					<svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
						<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
					</svg>
				</a>
			</div>
		</div>
	</header>

	<main class="bg-white">
		<!-- Hero Section -->
		<section class="pt-20 pb-12 px-4 sm:px-6 text-center">
			<div class="max-w-4xl mx-auto">
				<!-- Giant bold headline matching Ente screenshot -->
				<h1 class="text-5xl sm:text-6xl md:text-7xl font-extrabold tracking-tight leading-[1.08] mb-4 text-center">
					<span class="block text-[#00c853]">Safe diagnosis</span>
					<span class="block text-[#1a1a1a]">for your crops</span>
				</h1>

				<!-- Subhead matching screenshot -->
				<p class="text-neutral-400 text-base sm:text-lg text-center max-w-xl mx-auto mb-8 font-normal">
					End-to-end private. WebGPU accelerated. Open-source.
				</p>

				<!-- Dual Pill Buttons matching screenshot -->
				<div class="flex flex-wrap items-center justify-center gap-3.5 pt-1">
					<a href="#app" class="px-8 py-3.5 rounded-full bg-[#2d2d2d] hover:bg-[#1a1a1a] text-white font-medium text-sm transition shadow-sm inline-flex items-center gap-2">
						Diagnose Plant
					</a>
					<a href="https://github.com/KingNish24/P2P" target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 rounded-full bg-[#f3f4f6] hover:bg-[#e5e7eb] text-[#1f2937] font-medium text-sm transition inline-flex items-center gap-2">
						GitHub
					</a>
				</div>
			</div>
		</section>

		<!-- Photo Fan / Gallery Shelf (matching Ente photo fan) -->
		<section class="py-8 px-4 overflow-hidden max-w-5xl mx-auto">
			<div class="relative flex items-center justify-center -space-x-3 sm:-space-x-6 md:-space-x-8 pt-6 pb-12 select-none">
				<!-- Card 1: Tomato -->
				<button type="button" data-sample="/samples/tomato.jpg" class="sample-btn group cursor-pointer text-left relative aspect-[4/5] w-36 sm:w-52 md:w-56 rounded-3xl sm:rounded-[30px] border-[5px] sm:border-[6px] border-white ring-1 ring-black/5 shadow-xl bg-white overflow-hidden -rotate-8 translate-y-3 sm:translate-y-5 z-10 hover:rotate-0 hover:-translate-y-4 hover:scale-105 hover:z-40 hover:shadow-2xl transition-all duration-300 ease-out">
					<img src="/samples/tomato.jpg" alt="Tomato" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
					<div class="absolute bottom-2.5 sm:bottom-3 inset-x-2.5 sm:inset-x-3 pointer-events-none">
						<div class="bg-black/40 backdrop-blur-md border border-white/20 rounded-full px-2.5 py-1 flex items-center justify-between text-white shadow-xs">
							<span class="text-[10px] sm:text-xs font-semibold">Tomato</span>
							<span class="inline-flex items-center gap-1 text-[9px] sm:text-[10px] font-medium text-rose-300">
								<span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span>
								Unhealthy
							</span>
						</div>
					</div>
				</button>

				<!-- Card 2: Corn -->
				<button type="button" data-sample="/samples/corn.jpg" class="sample-btn group cursor-pointer text-left relative aspect-[4/5] w-36 sm:w-52 md:w-56 rounded-3xl sm:rounded-[30px] border-[5px] sm:border-[6px] border-white ring-1 ring-black/5 shadow-xl bg-white overflow-hidden -rotate-2 translate-y-0 sm:translate-y-1 z-20 hover:rotate-0 hover:-translate-y-4 hover:scale-105 hover:z-40 hover:shadow-2xl transition-all duration-300 ease-out">
					<img src="/samples/corn.jpg" alt="Corn" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
					<div class="absolute bottom-2.5 sm:bottom-3 inset-x-2.5 sm:inset-x-3 pointer-events-none">
						<div class="bg-black/40 backdrop-blur-md border border-white/20 rounded-full px-2.5 py-1 flex items-center justify-between text-white shadow-xs">
							<span class="text-[10px] sm:text-xs font-semibold">Corn</span>
							<span class="inline-flex items-center gap-1 text-[9px] sm:text-[10px] font-medium text-emerald-300">
								<span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
								Healthy
							</span>
						</div>
					</div>
				</button>

				<!-- Card 3: Spinach -->
				<button type="button" data-sample="/samples/spinach.jpg" class="sample-btn group cursor-pointer text-left relative aspect-[4/5] w-36 sm:w-52 md:w-56 rounded-3xl sm:rounded-[30px] border-[5px] sm:border-[6px] border-white ring-1 ring-black/5 shadow-xl bg-white overflow-hidden rotate-2 -translate-y-2 sm:-translate-y-3 z-30 hover:rotate-0 hover:-translate-y-6 hover:scale-105 hover:z-40 hover:shadow-2xl transition-all duration-300 ease-out">
					<img src="/samples/spinach.jpg" alt="Spinach" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
					<div class="absolute bottom-2.5 sm:bottom-3 inset-x-2.5 sm:inset-x-3 pointer-events-none">
						<div class="bg-black/40 backdrop-blur-md border border-white/20 rounded-full px-2.5 py-1 flex items-center justify-between text-white shadow-xs">
							<span class="text-[10px] sm:text-xs font-semibold">Spinach</span>
							<span class="inline-flex items-center gap-1 text-[9px] sm:text-[10px] font-medium text-rose-300">
								<span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span>
								Unhealthy
							</span>
						</div>
					</div>
				</button>

				<!-- Card 4: Potato -->
				<button type="button" data-sample="/samples/potato.jpg" class="sample-btn group cursor-pointer text-left relative aspect-[4/5] w-36 sm:w-52 md:w-56 rounded-3xl sm:rounded-[30px] border-[5px] sm:border-[6px] border-white ring-1 ring-black/5 shadow-xl bg-white overflow-hidden rotate-8 translate-y-3 sm:translate-y-5 z-10 hover:rotate-0 hover:-translate-y-4 hover:scale-105 hover:z-40 hover:shadow-2xl transition-all duration-300 ease-out">
					<img src="/samples/potato.jpg" alt="Potato" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
					<div class="absolute bottom-2.5 sm:bottom-3 inset-x-2.5 sm:inset-x-3 pointer-events-none">
						<div class="bg-black/40 backdrop-blur-md border border-white/20 rounded-full px-2.5 py-1 flex items-center justify-between text-white shadow-xs">
							<span class="text-[10px] sm:text-xs font-semibold">Potato</span>
							<span class="inline-flex items-center gap-1 text-[9px] sm:text-[10px] font-medium text-rose-300">
								<span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span>
								Unhealthy
							</span>
						</div>
					</div>
				</button>
			</div>
		</section>

		<!-- Interactive App Section -->
		<section id="app" class="scroll-mt-20 max-w-2xl mx-auto px-4 py-12">
			<!-- Ente-styled white card -->
			<div class="bg-white border border-neutral-200/80 shadow-xl rounded-3xl p-6 sm:p-8 space-y-6">
				<!-- Header -->
				<div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-neutral-100">
					<div>
						<h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[#1a1a1a]">Crop Health Analysis</h2>
						<p class="text-xs text-neutral-400 mt-0.5">Gemini Google Gemma4 E2B vision language model running locally on-device.</p>
					</div>
					<div class="text-[11px] font-mono text-neutral-500 bg-neutral-100 px-3 py-1 rounded-full">
						q4f16 &middot; 450M
					</div>
				</div>

				<!-- Progress bar container -->
				<div id="progress-container" class="hidden p-4 rounded-2xl bg-neutral-50 border border-neutral-200/80 space-y-2 text-neutral-700">
					<div class="flex justify-between text-xs font-mono text-neutral-600">
						<span id="progress-file" class="break-all font-medium">Loading model weights...</span>
						<span id="progress-percent" class="text-[#00c853] font-bold ml-2">0%</span>
					</div>
					<div id="progress-bar-wrap" class="w-full h-1.5 rounded-full bg-neutral-200 overflow-hidden">
						<div id="progress-fill" class="h-full bg-[#00c853] transition-all duration-150" style="width: 0%"></div>
					</div>
				</div>

				<!-- Dropzone with #00c853 hover border -->
				<div class="space-y-3">
					<div id="dropzone" class="relative group border-2 border-dashed border-neutral-300 hover:border-[#00c853] bg-neutral-50/60 hover:bg-[#00c853]/5 rounded-2xl p-8 text-center transition cursor-pointer min-h-[220px] flex flex-col items-center justify-center overflow-hidden">
						<input type="file" id="file-input" accept="image/*" class="absolute inset-0 opacity-0 cursor-pointer z-10" />

						<div id="upload-placeholder" class="space-y-3">
							<div class="w-12 h-12 rounded-2xl bg-[#00c853]/10 text-[#00c853] border border-[#00c853]/20 flex items-center justify-center mx-auto transition group-hover:scale-105">
								<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
									<path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
								</svg>
							</div>
							<div>
								<p class="text-sm font-semibold text-[#1a1a1a]">Drop plant, crop, fruit, or leaf image here</p>
								<p class="text-xs text-neutral-400 mt-0.5">Click to browse or drag &amp; drop from your files</p>
							</div>
						</div>

						<img id="image-preview" class="hidden max-h-72 max-w-full rounded-xl object-contain shadow-sm" alt="Selected Crop" />
					</div>

					<div class="flex gap-2">
						<button id="btn-camera" type="button" class="flex-1 py-2.5 px-3 rounded-full border border-neutral-200 bg-neutral-50 hover:bg-neutral-100 text-neutral-700 text-xs font-medium transition cursor-pointer flex items-center justify-center gap-1.5">
							<svg class="w-4 h-4 text-neutral-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
								<circle cx="12" cy="13" r="4" />
							</svg>
							<span>Take Photo</span>
						</button>
						<button id="btn-clear" type="button" class="hidden py-2.5 px-4 rounded-full border border-rose-200 bg-rose-50 hover:bg-rose-100 text-rose-700 text-xs font-medium transition cursor-pointer">
							Clear
						</button>
					</div>
				</div>

				<!-- Symptoms Note -->
				<div>
					<input type="text" id="user-note" placeholder="Optional notes (e.g. brown lesions noticed on lower leaves)..." class="w-full bg-neutral-50 border border-neutral-200 text-[#1a1a1a] placeholder-neutral-400 rounded-2xl px-4 py-3 text-xs focus:bg-white focus:border-[#00c853] focus:ring-2 focus:ring-[#00c853]/10 focus:outline-none transition" />
				</div>

				<!-- Diagnose Button matching Ente style -->
				<button id="btn-analyze" disabled type="button" class="w-full py-3.5 rounded-full bg-[#2d2d2d] hover:bg-[#1a1a1a] disabled:bg-neutral-200 disabled:text-neutral-400 disabled:cursor-not-allowed text-white text-xs font-bold uppercase tracking-wider shadow-md transition cursor-pointer flex items-center justify-center gap-2">
					<span id="btn-icon" class="flex items-center">
						<svg class="w-4 h-4 fill-none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
						</svg>
					</span>
					<span id="btn-text">Diagnose Plant</span>
				</button>

				<!-- Reasoning Stream Box -->
				<section id="reasoning-section" class="hidden pt-4 border-t border-neutral-100 space-y-2">
					<div class="flex items-center justify-between text-xs text-neutral-500 font-mono">
						<span class="flex items-center gap-1.5 text-[#00a846] font-medium">
							<span class="w-1.5 h-1.5 rounded-full bg-[#00c853] animate-pulse"></span>
							LFM2.5 Reasoning (Chain of Thought)
						</span>
						<span id="token-counter">0 tokens</span>
					</div>
					<div id="reasoning-box" class="p-4 rounded-2xl bg-neutral-900 text-neutral-200 border border-neutral-800 font-mono text-xs leading-relaxed whitespace-pre-wrap max-h-48 overflow-y-auto"></div>
				</section>

				<!-- Structured Result Card -->
				<section id="result-card" class="hidden pt-6 border-t border-neutral-100 space-y-6 text-[#1a1a1a]">
					<!-- Header -->
					<div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-neutral-100">
						<div>
							<div class="flex items-center gap-2 mb-1.5">
								<span id="res-status" class="px-3 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider"></span>
								<span id="res-pathogen" class="px-2.5 py-0.5 rounded-full text-xs bg-neutral-100 text-neutral-700 font-mono"></span>
								<span id="res-confidence" class="text-xs font-mono text-neutral-400"></span>
							</div>
							<h3 id="res-disease" class="text-2xl font-bold text-[#1a1a1a] tracking-tight"></h3>
							<p id="res-crop" class="text-xs text-neutral-500 mt-0.5"></p>
						</div>
					</div>

					<!-- Symptoms -->
					<div>
						<h4 class="text-xs font-semibold uppercase tracking-wider text-neutral-400 mb-2">Observed Symptoms</h4>
						<ul id="res-symptoms" class="text-neutral-700 list-disc list-inside space-y-1.5 text-xs"></ul>
					</div>

					<!-- Treatments Grid -->
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
						<!-- Organic Box -->
						<div class="p-5 rounded-2xl bg-[#00c853]/5 border border-[#00c853]/20 text-[#1a1a1a]">
							<div class="flex items-center gap-1.5 mb-2.5">
								<svg class="w-4 h-4 text-[#00c853]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 0 0 9-9c0-4.97-4.03-9-9-9S3 7.03 3 12a9 9 0 0 0 9 9zm0 0v-8m0 0a4 4 0 0 1 4-4m-4 4a4 4 0 0 0-4-4" />
								</svg>
								<h5 class="text-xs font-bold uppercase tracking-wider text-[#00a846]">Organic Remedies</h5>
							</div>
							<ul id="res-organic" class="space-y-1.5 text-xs text-neutral-700 list-disc list-inside"></ul>
						</div>

						<!-- Chemical Box -->
						<div class="p-5 rounded-2xl bg-neutral-50 border border-neutral-200 text-[#1a1a1a]">
							<div class="flex items-center gap-1.5 mb-2.5">
								<svg class="w-4 h-4 text-neutral-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 21a3 3 0 0 1-3 3H7.5a3 3 0 0 1-3-3l1.5-7.5V6a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v7.5l1.5 7.5zM9 4v4m6-4v4" />
								</svg>
								<h5 class="text-xs font-bold uppercase tracking-wider text-neutral-800">Chemical Controls</h5>
							</div>
							<ul id="res-chemical" class="space-y-1.5 text-xs text-neutral-700 list-disc list-inside"></ul>
						</div>
					</div>

					<!-- Prevention Box -->
					<div class="p-5 rounded-2xl bg-neutral-50 border border-neutral-200 text-[#1a1a1a]">
						<div class="flex items-center gap-1.5 mb-2.5">
							<svg class="w-4 h-4 text-neutral-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
							</svg>
							<h5 class="text-xs font-bold uppercase tracking-wider text-neutral-700">Prevention Protocols</h5>
						</div>
						<ul id="res-prevention" class="space-y-1.5 text-xs text-neutral-600 list-disc list-inside"></ul>
					</div>
				</section>
			</div>
		</section>

		<!-- Feature Grid matching Ente style -->
		<section id="features" class="scroll-mt-24 py-16 border-t border-neutral-100 max-w-6xl mx-auto px-4 sm:px-6">
			<div class="text-center max-w-xl mx-auto mb-12 space-y-2">
				<h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#1a1a1a]">Engineered for absolute privacy</h2>
				<p class="text-sm text-neutral-400">Zero telemetry, local machine learning models, and uncompromising crop diagnostics.</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
				<!-- Card 1 -->
				<div class="p-8 rounded-3xl bg-white border border-neutral-200/80 shadow-sm hover:shadow-md transition space-y-4">
					<div class="w-12 h-12 rounded-2xl bg-[#00c853]/10 text-[#00c853] flex items-center justify-center">
						<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
						</svg>
					</div>
					<h3 class="text-base font-bold text-[#1a1a1a]">Client-Side Privacy</h3>
					<p class="text-xs text-neutral-500 leading-relaxed">
						Images are processed in sandbox memory directly on your GPU or CPU. No photographs ever leave your browser or get logged on remote servers.
					</p>
				</div>

				<!-- Card 2 -->
				<div class="p-8 rounded-3xl bg-white border border-neutral-200/80 shadow-sm hover:shadow-md transition space-y-4">
					<div class="w-12 h-12 rounded-2xl bg-[#00c853]/10 text-[#00c853] flex items-center justify-center">
						<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<rect x="4" y="4" width="16" height="16" rx="2" />
							<rect x="9" y="9" width="6" height="6" />
							<path stroke-linecap="round" stroke-linejoin="round" d="M9 1v3m6-3v3M9 20v3m6-3v3M20 9h3m-3 6h3M1 9h3m-3 6h3" />
						</svg>
					</div>
					<h3 class="text-base font-bold text-[#1a1a1a]">Gemini Google Gemma4 E2B Edge Engine</h3>
					<p class="text-xs text-neutral-500 leading-relaxed">
						Highly optimized 450M parameter vision-language model compiled to WebGPU WGSL shaders. Runs smoothly on consumer laptops and mobile devices.
					</p>
				</div>

				<!-- Card 3 -->
				<div class="p-8 rounded-3xl bg-white border border-neutral-200/80 shadow-sm hover:shadow-md transition space-y-4">
					<div class="w-12 h-12 rounded-2xl bg-[#00c853]/10 text-[#00c853] flex items-center justify-center">
						<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 21a3 3 0 0 1-3 3H7.5a3 3 0 0 1-3-3l1.5-7.5V6a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v7.5l1.5 7.5zM9 4v4m6-4v4" />
						</svg>
					</div>
					<h3 class="text-base font-bold text-[#1a1a1a]">Dual Agronomic Guidance</h3>
					<p class="text-xs text-neutral-500 leading-relaxed">
						Instant dual recommendations pairing bio-friendly organic interventions with targeted chemical controls and seasonal preventative maintenance.
					</p>
				</div>
			</div>
		</section>

		<!-- Comparison Matrix -->
		<section id="architecture" class="scroll-mt-24 py-16 border-t border-neutral-100 max-w-6xl mx-auto px-4 sm:px-6 mb-16">
			<div class="text-center max-w-xl mx-auto mb-12 space-y-2">
				<h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#1a1a1a]">Cloud AI vs Disease Dekho AI Edge</h2>
				<p class="text-sm text-neutral-400">Why local execution is the optimal architectural pattern for agricultural diagnostics.</p>
			</div>

			<div class="overflow-hidden bg-white border border-neutral-200/80 rounded-3xl shadow-sm">
				<div class="overflow-x-auto">
					<table class="w-full text-left text-xs border-collapse">
						<thead>
							<tr class="border-b border-neutral-200 bg-neutral-50/70 text-neutral-600 font-mono">
								<th class="py-4 px-6 font-semibold">Architectural Vector</th>
								<th class="py-4 px-6 font-semibold text-neutral-400">Traditional Cloud AI</th>
								<th class="py-4 px-6 font-semibold text-[#00a846] bg-[#00c853]/5">Disease Dekho AI On-Device</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-neutral-100 text-neutral-700">
							<tr>
								<td class="py-4 px-6 font-medium text-[#1a1a1a]">Data Privacy</td>
								<td class="py-4 px-6 text-neutral-400">Crop images uploaded to central servers</td>
								<td class="py-4 px-6 font-semibold text-[#00a846] bg-[#00c853]/5">Zero cloud transmission (100% on-device)</td>
							</tr>
							<tr>
								<td class="py-4 px-6 font-medium text-[#1a1a1a]">Offline Capability</td>
								<td class="py-4 px-6 text-neutral-400">Requires continuous network connectivity</td>
								<td class="py-4 px-6 font-semibold text-[#00a846] bg-[#00c853]/5">Caches weights; runs offline in field</td>
							</tr>
							<tr>
								<td class="py-4 px-6 font-medium text-[#1a1a1a]">Inference Latency</td>
								<td class="py-4 px-6 text-neutral-400">Variable (network latency + queueing)</td>
								<td class="py-4 px-6 font-semibold text-[#00a846] bg-[#00c853]/5">Instant local WebGPU streaming</td>
							</tr>
							<tr>
								<td class="py-4 px-6 font-medium text-[#1a1a1a]">Operational Cost</td>
								<td class="py-4 px-6 text-neutral-400">Per-token API fees &amp; cloud infra</td>
								<td class="py-4 px-6 font-semibold text-[#00a846] bg-[#00c853]/5">Zero server compute ($0.00 / perpetual)</td>
							</tr>
							<tr>
								<td class="py-4 px-6 font-medium text-[#1a1a1a]">Auditability</td>
								<td class="py-4 px-6 text-neutral-400">Closed-source proprietary APIs</td>
								<td class="py-4 px-6 font-semibold text-[#00a846] bg-[#00c853]/5">Open weights, open source code</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
		</section>
	</main>

	<!-- Clean Footer -->
	<footer class="border-t border-neutral-100 bg-white py-12">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-neutral-400">
			<div class="flex items-center gap-2">
				<div class="w-6 h-6 flex items-center justify-center">
					<svg class="w-5 h-5 fill-[#00c853]" viewBox="0 0 24 24">
						<path d="M21 3c-6.627 0-12 5.373-12 12v1H7a5 5 0 0 0-5 5h2a3 3 0 0 1 3-3h4a2 2 0 0 0 2-2v-3c0-4.418 3.582-8 8-8V3z"/>
					</svg>
				</div>
				<span class="font-bold text-[#1a1a1a]">Disease Dekho AI</span>
				<span>&middot; Edge AI Crop Health &amp; Agronomic Diagnostics</span>
			</div>
			<p class="text-center sm:text-right">
				For research and agricultural assistance. Powered by WebGPU &amp; Gemini Google Gemma4 E2B.
			</p>
		</div>
	</footer>

	<!-- Camera Modal -->
	<div id="camera-modal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4">
		<div class="bg-white border border-neutral-200 rounded-3xl max-w-sm w-full p-5 shadow-2xl space-y-3">
			<div class="flex items-center justify-between">
				<span class="text-xs font-bold text-[#1a1a1a]">Capture Plant Photo</span>
				<button id="btn-close-camera" type="button" class="text-neutral-400 hover:text-neutral-700 transition p-1">
					<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
					</svg>
				</button>
			</div>
			<div class="relative rounded-2xl overflow-hidden bg-neutral-950 aspect-square">
				<video id="camera-video" autoplay playsinline class="w-full h-full object-cover"></video>
			</div>
			<div class="flex gap-2">
				<button id="btn-snap" type="button" class="flex-1 py-2.5 rounded-full bg-[#2d2d2d] hover:bg-[#1a1a1a] text-white font-bold text-xs transition cursor-pointer">
					Snap Photo
				</button>
				<button id="btn-cancel-camera" type="button" class="py-2.5 px-4 rounded-full border border-neutral-200 text-neutral-700 hover:bg-neutral-50 text-xs font-medium transition cursor-pointer">
					Cancel
				</button>
			</div>
		</div>
	</div>

	<!-- Client Script -->
	<script>
		let worker = null;
		let selectedImageDataUrl = null;
		let cameraStream = null;
		let tokenCount = 0;

		const iconBolt = `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`;
		const iconSpinner = `<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path></svg>`;
		const iconError = `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>`;

		const webgpuDot = document.getElementById('webgpu-dot');
		const webgpuStatus = document.getElementById('webgpu-status');

		const progressContainer = document.getElementById('progress-container');
		const progressFile = document.getElementById('progress-file');
		const progressPercent = document.getElementById('progress-percent');
		const progressFill = document.getElementById('progress-fill');
		const progressBarWrap = document.getElementById('progress-bar-wrap');

		const dropzone = document.getElementById('dropzone');
		const fileInput = document.getElementById('file-input');
		const uploadPlaceholder = document.getElementById('upload-placeholder');
		const imagePreview = document.getElementById('image-preview');
		const btnClear = document.getElementById('btn-clear');
		const userNoteInput = document.getElementById('user-note');
		const btnAnalyze = document.getElementById('btn-analyze');
		const btnIcon = document.getElementById('btn-icon');
		const btnText = document.getElementById('btn-text');

		const reasoningSection = document.getElementById('reasoning-section');
		const reasoningBox = document.getElementById('reasoning-box');
		const tokenCounter = document.getElementById('token-counter');

		const resultCard = document.getElementById('result-card');
		const resStatus = document.getElementById('res-status');
		const resPathogen = document.getElementById('res-pathogen');
		const resConfidence = document.getElementById('res-confidence');
		const resDisease = document.getElementById('res-disease');
		const resCrop = document.getElementById('res-crop');
		const resSymptoms = document.getElementById('res-symptoms');
		const resOrganic = document.getElementById('res-organic');
		const resChemical = document.getElementById('res-chemical');
		const resPrevention = document.getElementById('res-prevention');

		const btnCamera = document.getElementById('btn-camera');
		const cameraModal = document.getElementById('camera-modal');
		const cameraVideo = document.getElementById('camera-video');
		const btnCloseCamera = document.getElementById('btn-close-camera');
		const btnCancelCamera = document.getElementById('btn-cancel-camera');
		const btnSnap = document.getElementById('btn-snap');

		function showError(msg) {
			progressContainer.classList.remove('hidden');
			progressFile.innerHTML = `<span class="text-rose-500 font-bold">Error:</span> ${msg}`;
			progressPercent.textContent = '!';
			progressFill.className = 'h-full bg-rose-500';
			btnAnalyze.disabled = false;
			btnText.textContent = 'Retry Diagnosis';
			btnIcon.innerHTML = iconError;
		}

		async function checkWebGPU() {
			if ('gpu' in navigator) {
				try {
					const adapter = await navigator.gpu.requestAdapter();
					if (adapter) {
						webgpuDot.className = 'w-2 h-2 rounded-full bg-[#00c853]';
						webgpuStatus.textContent = 'WebGPU Ready';
						return true;
					}
				} catch (e) {
					console.warn(e);
				}
			}
			webgpuDot.className = 'w-2 h-2 rounded-full bg-amber-400';
			webgpuStatus.textContent = 'WebGPU Fallback';
			return false;
		}

		function getWorker() {
			if (worker) return worker;

			worker = new Worker(new URL('../scripts/ai-worker.js', import.meta.url), {
				type: 'module'
			});

			worker.onerror = (e) => {
				console.error('Worker error event:', e);
				showError(e.message || 'Worker script failed to execute (CORS or network error).');
			};

			worker.addEventListener('message', (event) => {
				const { type, status, message, progress, token, fullText, data } = event.data;

				if (type === 'status') {
					if (status === 'loading') {
						progressContainer.classList.remove('hidden');
						progressFile.textContent = message;
						btnText.textContent = 'Loading Weights...';
					} else if (status === 'ready') {
						progressContainer.classList.add('hidden');
					} else if (status === 'analyzing') {
						btnText.textContent = 'Reasoning...';
					}
				}

				if (type === 'progress') {
					progressContainer.classList.remove('hidden');
					if (progress.file) progressFile.textContent = progress.file;
					if (progress.progress !== undefined) {
						const pct = Math.round(progress.progress);
						progressPercent.textContent = `${pct}%`;
						progressFill.style.width = `${pct}%`;
					}
				}

				if (type === 'token') {
					tokenCount++;
					tokenCounter.textContent = `${tokenCount} tokens`;
					reasoningSection.classList.remove('hidden');
					reasoningBox.textContent = fullText;
					reasoningBox.scrollTop = reasoningBox.scrollHeight;
				}

				if (type === 'result') {
					renderResult(data);
					btnAnalyze.disabled = false;
					btnText.textContent = 'Diagnose Plant';
					btnIcon.innerHTML = iconBolt;
				}

				if (type === 'error') {
					showError(message);
				}
			});

			return worker;
		}

		function renderResult(data) {
			resultCard.classList.remove('hidden');

			const isHealthy = data.status === 'healthy';
			resStatus.textContent = isHealthy ? 'HEALTHY' : 'DISEASED';
			resStatus.className = isHealthy 
				? 'px-3 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider bg-[#00c853]/10 text-[#00a846] border border-[#00c853]/30'
				: 'px-3 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-100 text-rose-800 border border-rose-300';

			if (data.pathogen_type) {
				resPathogen.textContent = data.pathogen_type.toUpperCase();
				resPathogen.classList.remove('hidden');
			} else {
				resPathogen.classList.add('hidden');
			}
			resConfidence.textContent = `Confidence: ${(data.confidence || 'medium').toUpperCase()}`;
			resDisease.textContent = data.disease_name || 'Diagnosis';
			resCrop.innerHTML = `Crop: <span class="text-[#1a1a1a] font-semibold">${data.crop || 'Plant'}</span>`;

			resSymptoms.innerHTML = (data.key_symptoms || []).map(s => `<li>${s}</li>`).join('');
			resOrganic.innerHTML = (data.organic_treatment || []).map(t => `<li>${t}</li>`).join('');
			resChemical.innerHTML = (data.chemical_treatment || []).map(c => `<li>${c}</li>`).join('');
			resPrevention.innerHTML = (data.prevention_measures || []).map(p => `<li>${p}</li>`).join('');

			resultCard.scrollIntoView({ behavior: 'smooth' });
		}

		function setImage(dataUrl) {
			selectedImageDataUrl = dataUrl;
			imagePreview.src = dataUrl;
			imagePreview.classList.remove('hidden');
			uploadPlaceholder.classList.add('hidden');
			btnClear.classList.remove('hidden');
			btnAnalyze.disabled = false;
		}

		function clearImage() {
			selectedImageDataUrl = null;
			imagePreview.src = '';
			imagePreview.classList.add('hidden');
			uploadPlaceholder.classList.remove('hidden');
			btnClear.classList.add('hidden');
			btnAnalyze.disabled = true;
			fileInput.value = '';
			resultCard.classList.add('hidden');
			reasoningSection.classList.add('hidden');
		}

		fileInput.addEventListener('change', (e) => {
			const file = e.target.files[0];
			if (file) {
				const reader = new FileReader();
				reader.onload = (evt) => setImage(evt.target.result);
				reader.readAsDataURL(file);
			}
		});

		['dragenter', 'dragover'].forEach((type) => {
			dropzone.addEventListener(type, (e) => {
				e.preventDefault();
				e.stopPropagation();
				dropzone.classList.add('border-[#00c853]', 'bg-[#00c853]/10');
			});
		});

		dropzone.addEventListener('dragleave', (e) => {
			e.preventDefault();
			e.stopPropagation();
			dropzone.classList.remove('border-[#00c853]', 'bg-[#00c853]/10');
		});

		dropzone.addEventListener('drop', (e) => {
			e.preventDefault();
			e.stopPropagation();
			dropzone.classList.remove('border-[#00c853]', 'bg-[#00c853]/10');
			const file = e.dataTransfer?.files?.[0];
			if (file && file.type.startsWith('image/')) {
				const reader = new FileReader();
				reader.onload = (evt) => setImage(evt.target.result);
				reader.readAsDataURL(file);
			}
		});

		btnClear.addEventListener('click', clearImage);

		btnAnalyze.addEventListener('click', () => {
			if (!selectedImageDataUrl) return;

			tokenCount = 0;
			tokenCounter.textContent = '0 tokens';
			reasoningSection.classList.remove('hidden');
			reasoningBox.textContent = '// Model starting reasoning phase (first field)...\n';

			btnAnalyze.disabled = true;
			btnText.textContent = 'Thinking...';
			btnIcon.innerHTML = iconSpinner;

			const w = getWorker();
			w.postMessage({
				type: 'analyze',
				data: {
					image: selectedImageDataUrl,
					userNote: userNoteInput.value.trim()
				}
			});
		});

		// Camera
		btnCamera.addEventListener('click', async () => {
			cameraModal.classList.remove('hidden');
			try {
				cameraStream = await navigator.mediaDevices.getUserMedia({
					video: { facingMode: 'environment' }
				});
				cameraVideo.srcObject = cameraStream;
			} catch (err) {
				alert('Camera access denied or unavailable: ' + err.message);
				cameraModal.classList.add('hidden');
			}
		});

		function stopCamera() {
			if (cameraStream) {
				cameraStream.getTracks().forEach(t => t.stop());
				cameraStream = null;
			}
			cameraModal.classList.add('hidden');
		}

		btnCloseCamera.addEventListener('click', stopCamera);
		btnCancelCamera.addEventListener('click', stopCamera);

		btnSnap.addEventListener('click', () => {
			const canvas = document.createElement('canvas');
			canvas.width = cameraVideo.videoWidth || 640;
			canvas.height = cameraVideo.videoHeight || 480;
			const ctx = canvas.getContext('2d');
			ctx.drawImage(cameraVideo, 0, 0, canvas.width, canvas.height);
			setImage(canvas.toDataURL('image/jpeg', 0.85));
			stopCamera();
		});

		// Sample Fan Button Clicks
		document.querySelectorAll('.sample-btn').forEach((btn) => {
			btn.addEventListener('click', async () => {
				const sampleUrl = btn.getAttribute('data-sample');
				if (!sampleUrl) return;
				try {
					const res = await fetch(sampleUrl);
					const blob = await res.blob();
					const reader = new FileReader();
					reader.onload = (e) => {
						setImage(e.target.result);
						document.getElementById('app')?.scrollIntoView({ behavior: 'smooth' });
					};
					reader.readAsDataURL(blob);
				} catch (err) {
					console.error('Failed to load sample image:', err);
				}
			});
		});

		checkWebGPU();
	</script>
</Layout>
